{
  "$schema": "./cloudflare/node_modules/wrangler/config-schema.json",
  "name": "sub-store-cloudflare",
  "main": "cloudflare/src/index.ts",
  "workers_dev": true,
  "compatibility_date": "2026-07-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "secrets": {
    "required": [
      "SUB_STORE_ADMIN_TOKEN",
      "SUB_STORE_PUBLIC_DOWNLOAD_TOKEN"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sub-store-cloudflare",
      "database_id": "c93aa5b9-cae8-4230-9ccc-92ae907baf67",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "vars": {
    "SUB_STORE_APP_NAME": "q1i9C4Z0rootr5FGdbdRK71tq1C0mib6",
    "SUB_STORE_PUBLIC_DOWNLOAD_HOSTS": "hSYBGvKpdoi6H00UB0VMQ9WQqt56Zyud"
  }
}
